{
  "name": "Finance Executive Theme",
  "dataColors": [
    "#1F3864",
    "#2E75B6",
    "#548235",
    "#BF8F00",
    "#7F7F7F",
    "#8FAADC",
    "#A9D18E",
    "#C00000"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#1F3864",
  "good": "#548235",
  "neutral": "#BF8F00",
  "bad": "#C00000",
  "maximum": "#1F3864",
  "center": "#8FAADC",
  "minimum": "#F2F2F2",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1F3864"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#1F2937"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#404040"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#1F3864"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "transparency": 0,
            "color": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#D5DAE3" } },
            "radius": 6
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": { "solid": { "color": "#1F3864" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "alignment": "left"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "color": { "solid": { "color": "#6B7280" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "gridLineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#6B7280" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "gridLineShow": true,
            "gridLineColor": { "solid": { "color": "#EDEFF3" } },
            "gridlineStyle": "dotted",
            "gridLineThickness": 1
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "legendColor": { "solid": { "color": "#404040" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#404040" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#F7F9FC" } }
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#1F3864" } },
            "radius": 8
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#1F3864" } },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#6B7280" } },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#F7F8FA" } }
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#D5DAE3" } },
            "radius": 6
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1F3864" } },
            "fontSize": 10,
            "bold": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#1F2937" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#1F2937" } },
            "backColorSecondary": { "solid": { "color": "#F7F9FC" } },
            "fontSize": 9
          }
        ],
        "total": [
          {
            "totals": true,
            "fontColor": { "solid": { "color": "#1F3864" } },
            "backColor": { "solid": { "color": "#EDEFF3" } },
            "bold": true,
            "fontSize": 10
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "rowPadding": 6
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "RightCenter",
            "legendColor": { "solid": { "color": "#404040" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#1F2937" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    }
  }
}