{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.4.0/schema.json",
  "name": "chart-revenue-trend",
  "position": {
    "x": 20,
    "y": 240,
    "z": 0,
    "width": 900,
    "height": 420,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Date"
                    }
                  },
                  "Property": "MonthShort"
                }
              },
              "queryRef": "Dim_Date.MonthShort",
              "nativeQueryRef": "MonthShort"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Date"
                    }
                  },
                  "Property": "Year"
                }
              },
              "queryRef": "Dim_Date.Year",
              "nativeQueryRef": "Year"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Measures"
                    }
                  },
                  "Property": "Revenue"
                }
              },
              "queryRef": "Measures.Revenue",
              "nativeQueryRef": "Revenue"
            }
          ]
        }
      },
      "sortDefinition": {
        "isDefaultSort": true
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Revenue Trend by Month (Year over Year)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
