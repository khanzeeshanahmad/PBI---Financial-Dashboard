table Fact_Budget
	lineageTag: c84b14d3-67a5-4d76-b276-7946767ed1c0

	column 'Entry No.'
		dataType: int64
		isKey
		formatString: 0
		lineageTag: 603f8d10-ec91-43d6-bd45-91605afb80f6
		summarizeBy: none
		sourceColumn: Entry No.

		annotation SummarizationSetBy = Automatic

	column 'Budget Name'
		dataType: string
		lineageTag: eee37910-6b68-4a8f-b3f2-a626aeb20566
		summarizeBy: none
		sourceColumn: Budget Name

		annotation SummarizationSetBy = Automatic

	column 'G/L Account No.'
		dataType: string
		lineageTag: 59048cd6-25b6-4812-a4f1-fab6ea5e346f
		summarizeBy: none
		sourceColumn: G/L Account No.

		annotation SummarizationSetBy = Automatic

	column Date
		dataType: dateTime
		formatString: Short Date
		lineageTag: 696d8ac7-aa7b-407b-b5ff-9a79b7c3f55c
		summarizeBy: none
