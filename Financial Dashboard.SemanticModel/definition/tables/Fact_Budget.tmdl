	column Amount
		dataType: double
		formatString: \$#,0.00;(\$#,0.00)
		lineageTag: 905e76d6-8a02-4b82-b269-b9b85e96b024
		summarizeBy: sum
		sourceColumn: Amount

		annotation SummarizationSetBy = Automatic
		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

		/// Same sign convention as Fact_GLTransactions[Amount]: budgeted
		/// income/credit-normal accounts are stored as BC posts them and are
		/// negated by DAX measures, not here, so Actual and Budget compare on
		/// a like-for-like basis.

	partition Fact_Budget = m
		mode: import
		source =
				let
					Source = BusinessCentral.Contents(),
					Environment = Source{[Name = BCEnvironment]}[Data],
					Company = Environment{[Name = BCCompanyName]}[Data],
					#"G/L Budget Entries" = Company{[Name = "G/L Budget Entries"]}[Data],
					#"Selected Columns" = Table.SelectColumns(
						#"G/L Budget Entries",
						{
							"Entry No.", "Budget Name", "G/L Account No.", "Date",
							"Global Dimension 1 Code", "Global Dimension 2 Code", "Amount"
						},
						MissingField.UseNull
					),
					#"Changed Type" = Table.TransformColumnTypes(
						#"Selected Columns",
						{
							{"Entry No.", Int64.Type}, {"Budget Name", type text}, {"G/L Account No.", type text},
							{"Date", type datetime}, {"Global Dimension 1 Code", type text},
							{"Global Dimension 2 Code", type text}, {"Amount", type number}
						}
					)
				in
					#"Changed Type"

	/// COMPATIBILITY NOTE: exposed as "G/L Budget Entries" in the Navigator.
	/// A company may keep several named budgets (e.g. "BUDGET-2026",
	/// "FORECAST-2026") in this one entity, distinguished by [Budget Name] --
	/// add a slicer on that column in Desktop, or hard-filter this query to a
	/// single budget with Table.SelectRows if only one should ever be shown.

