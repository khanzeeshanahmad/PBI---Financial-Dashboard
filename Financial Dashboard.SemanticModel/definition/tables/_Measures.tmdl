	measure 'COGS PY' = CALCULATE([COGS], SAMEPERIODLASTYEAR(Dim_Date[Date]))
		formatString: \$#,0.00;(\$#,0.00)
		displayFolder: Time Intelligence\COGS
		lineageTag: 933f7574-6d56-48b7-a8a6-d1a85b13ffe3

	measure 'Operating Expenses YTD' = TOTALYTD([Operating Expenses], Dim_Date[Date])
		formatString: \$#,0.00;(\$#,0.00)
		displayFolder: Time Intelligence\Operating Expenses
		lineageTag: de7a2888-4d0c-4bbb-ae9b-f2adad9afdb6

	measure 'Operating Expenses PY' = CALCULATE([Operating Expenses], SAMEPERIODLASTYEAR(Dim_Date[Date]))
		formatString: \$#,0.00;(\$#,0.00)
		displayFolder: Time Intelligence\Operating Expenses
		lineageTag: 795d9c40-e693-4a1f-b203-97b2d83483bf

	measure 'Operating Income YTD' = TOTALYTD([Operating Income], Dim_Date[Date])
		formatString: \$#,0.00;(\$#,0.00)
		displayFolder: Time Intelligence\Operating Income
		lineageTag: 56ab34b1-1ec7-46d6-a8fc-995b8f273c2b

	measure 'Operating Income PY' = CALCULATE([Operating Income], SAMEPERIODLASTYEAR(Dim_Date[Date]))
		formatString: \$#,0.00;(\$#,0.00)
		displayFolder: Time Intelligence\Operating Income
		lineageTag: 0088bab7-0af6-43ea-8adc-89ee24b21f71

	measure 'Operating Income YoY %' = DIVIDE([Operating Income] - [Operating Income PY], [Operating Income PY])
