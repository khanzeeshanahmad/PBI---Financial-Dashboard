		lineageTag: f1c9073c-ca8e-43e3-a96d-36effd2a64d1
		summarizeBy: sum
		sourceColumn: Amount

		annotation SummarizationSetBy = Automatic
		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

		// Signed net amount in the company's local currency (Debit Amount -
		// Credit Amount), exactly as posted by BC. All P&L / Balance Sheet
		// measures are built from this column; see the data dictionary for
		// the sign convention (credit-normal accounts are negated in DAX, not
		// here, so this column always matches BC's own G/L Entry list).

	column 'User ID'
		dataType: string
