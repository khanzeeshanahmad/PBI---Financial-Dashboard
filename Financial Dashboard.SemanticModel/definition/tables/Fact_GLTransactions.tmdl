	partition Fact_GLTransactions = m
		mode: import
		source =
				let
					Source = BusinessCentral.Contents(),
					Environment = Source{[Name = BCEnvironment]}[Data],
					Company = Environment{[Name = BCCompanyName]}[Data],
					#"G/L Entries" = Company{[Name = "G/L Entries"]}[Data],
					#"Selected Columns" = Table.SelectColumns(
						#"G/L Entries",
						{
							"Entry No.", "G/L Account No.", "Posting Date", "Document No.", "Document Type",
							"Description", "Source Code", "Global Dimension 1 Code", "Global Dimension 2 Code",
							"Debit Amount", "Credit Amount", "Amount", "User ID"
						},
						MissingField.UseNull
					),
					#"Changed Type" = Table.TransformColumnTypes(
						#"Selected Columns",
						{
							{"Entry No.", Int64.Type}, {"G/L Account No.", type text}, {"Posting Date", type datetime},
							{"Document No.", type text}, {"Document Type", type text}, {"Description", type text},
							{"Source Code", type text}, {"Global Dimension 1 Code", type text},
							{"Global Dimension 2 Code", type text}, {"Debit Amount", type number},
							{"Credit Amount", type number}, {"Amount", type number}, {"User ID", type text}
						}
					),
					#"Filtered Rows" = Table.SelectRows(
						#"Changed Type",
						each [Posting Date] >= RangeStart and [Posting Date] < RangeEnd
					)
				in
					#"Filtered Rows"

	// COMPATIBILITY NOTE: the connector Navigator exposes this entity as
	// "G/L Entries" on current BC SaaS releases; older documentation calls it
	// "General Ledger Entries" or the underlying table name "G/L Entry"
	// (singular). Confirm the exact label in your Navigator and adjust the
	// literal above if it differs.
	//
	// INCREMENTAL REFRESH: this query already filters on RangeStart/RangeEnd.
	// After first publish, enable incremental refresh on this table from
	// Desktop (right-click > Incremental refresh) -- suggested policy:
	// store 5 years, incrementally refresh 1 month, detect data changes off
	// (BC does not expose a last-modified watermark on G/L Entry), since
	// posted G/L entries are immutable once posted.

